# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or share these values.
POSTGRES_DB=cerepath
POSTGRES_USER=cerepath
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
CEREPATH_OWNER_TOKEN=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
BROWSER_INTERNAL_TOKEN=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_TOKEN

# Local application configuration
APP_ENV=local
CEREPATH_SESSION_TTL_HOURS=12
LOG_LEVEL=INFO

# Select exactly one provider: bynara, gemini, ollama, or disabled.
# No automatic fallback is performed.
AI_PROVIDER=bynara

# Approved memories remain local for hosted providers unless you explicitly opt in.
# Even when enabled, only memories matching the recent conversation are shared.
# The current prompt and bounded chat history are still sent to the selected provider.
REMOTE_PROVIDER_MEMORY_SHARING=false

# Bynara hosted router (optional).
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_MODEL=gpt-5.6-luna
BYNARA_API_KEY=CHANGE_ME_ADD_YOUR_BYNARA_KEY

# Google Gemini Developer API (optional).
# Gemini's OpenAI-compatible Chat Completions endpoint.
# Free-tier prompts and responses may be used by Google to improve products.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=CHANGE_ME_ADD_YOUR_GEMINI_KEY

# Hosted provider traffic uses the restricted HTTPS CONNECT egress proxy.
AI_HTTP_PROXY=http://egress-proxy:3128

# Optional local Ollama on the host. Set AI_PROVIDER=ollama to use it.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

# The local bootstrap token exchanges for a revocable HTTP-only browser session.
# This is single-owner local authentication, not OIDC/passkeys or public multi-user auth.

# Optional local-only embeddings. Requires Ollama on the host.
# Install once with: ollama pull all-minilm
# No remote embedding service or automatic fallback is used.
EMBEDDING_PROVIDER=disabled
OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
