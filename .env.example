# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or share these values.
POSTGRES_DB=cerepath
POSTGRES_USER=cerepath
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
CEREPATH_OWNER_TOKEN=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
BROWSER_INTERNAL_TOKEN=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_TOKEN

# Local application configuration
APP_ENV=local
CEREPATH_SESSION_TTL_HOURS=12
LOG_LEVEL=INFO

# AI provider: bynara (hosted), ollama (local host runtime), or disabled.
# Bynara sends chat messages and selected approved memory context to the provider.
# The API key is never stored in the database or browser.
AI_PROVIDER=bynara
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_MODEL=gpt-5.6-luna
BYNARA_API_KEY=CHANGE_ME_ADD_YOUR_BYNARA_KEY
# Bynara traffic uses the restricted HTTPS CONNECT egress proxy.
AI_HTTP_PROXY=http://egress-proxy:3128

# Optional local Ollama on the host. Set AI_PROVIDER=ollama to use it.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

# The local bootstrap token exchanges for a revocable HTTP-only browser session.
# This is single-owner local authentication, not OIDC/passkeys or public multi-user auth.
